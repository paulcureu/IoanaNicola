{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/book/**",
              "components/core/**",
              "components/navigation/**",
              "components/site/**",
              "ui_kits/portfolio-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Noto Sans))/i]",
        "message": "Font not provided by the design system. Available: Noto Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|icon|iconAfter|onClick|href|download|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, icon, iconAfter, onClick, href, download, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|outline|text|inverse|outline-inverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'outline' | 'text' | 'inverse' | 'outline-inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Figure'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|width|height|onOpen|maxHeight|openLabel|style|key|ref|className|style|children)$/]",
        "message": "<Figure> doesn't accept that prop. Declared props: src, alt, caption, width, height, onOpen, maxHeight, openLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlipBook'] > JSXAttribute > JSXIdentifier[name!=/^(?:pages|page|onPageChange|mode|aspect|keyboard|altPrefix|style|key|ref|className|style|children)$/]",
        "message": "<FlipBook> doesn't accept that prop. Declared props: pages, page, onPageChange, mode, aspect, keyboard, altPrefix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlipBook'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:spread|single)$/]",
        "message": "<FlipBook> mode must be one of 'spread' | 'single'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|className|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|onClick|href|download|variant|size|disabled|active|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, onClick, href, download, variant, size, disabled, active, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|outline|inverse)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'outline' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LanguageToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|inverse|style|key|ref|className|style|children)$/]",
        "message": "<LanguageToggle> doesn't accept that prop. Declared props: value, onChange, options, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LightboxItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|caption|key|ref|className|style|children)$/]",
        "message": "<LightboxItem> doesn't accept that prop. Declared props: src, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|total|range|inverse|style|key|ref|className|style|children)$/]",
        "message": "<PageCounter> doesn't accept that prop. Declared props: page, total, range, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProjectCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|image|number|title|discipline|aspect|imagePosition|badge|style|key|ref|className|style|children)$/]",
        "message": "<ProjectCard> doesn't accept that prop. Declared props: href, onClick, image, number, title, discipline, aspect, imagePosition, badge, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PagerItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|number|title|key|ref|className|style|children)$/]",
        "message": "<PagerItem> doesn't accept that prop. Declared props: href, number, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|delay|y|duration|once|disabled|as|style|key|ref|className|style|children)$/]",
        "message": "<Reveal> doesn't accept that prop. Declared props: children, delay, y, duration, once, disabled, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|download|key|ref|className|style|children)$/]",
        "message": "<FooterLink> doesn't accept that prop. Declared props: label, href, download."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|active|key|ref|className|style|children)$/]",
        "message": "<SiteLink> doesn't accept that prop. Declared props: label, href, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='SwipeViewer'] > JSXAttribute > JSXIdentifier[name!=/^(?:pages|page|onPageChange|aspect|gap|altPrefix|style|key|ref|className|style|children)$/]",
        "message": "<SwipeViewer> doesn't accept that prop. Declared props: pages, page, onPageChange, aspect, gap, altPrefix, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TocSection'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|title|subtitle|page|key|ref|className|style|children)$/]",
        "message": "<TocSection> doesn't accept that prop. Declared props: number, title, subtitle, page."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toolbar'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|total|range|onPrev|onNext|canPrev|canNext|onContents|contentsOpen|onFullscreen|isFullscreen|downloadHref|downloadName|lang|onLangChange|labels|inverse|compact|style|key|ref|className|style|children)$/]",
        "message": "<Toolbar> doesn't accept that prop. Declared props: page, total, range, onPrev, onNext, canPrev, canNext, onContents, contentsOpen, onFullscreen, isFullscreen, downloadHref, downloadName, lang, onLangChange, labels, inverse, compact, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
